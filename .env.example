# Copy to .env.local and fill in. .env*.local is gitignored.

# --- Contact form (Resend) -------------------------------------------------
# Without RESEND_API_KEY the /api/contact route returns 503 "not_configured"
# and the form shows a mailto fallback instead of pretending to send.
# Get a key: https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to siteConfig.email if unset.
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend for real delivery.
# Defaults to onboarding@resend.dev, which only delivers to the address that
# owns the Resend account, so it is test-only.
CONTACT_FROM_EMAIL=

# --- Sanity (blog) ---------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# --- Database --------------------------------------------------------------
DATABASE_URL=

# --- Project card thumbnails (optional) ------------------------------------
# Without this, project cards fall back to a typographic placeholder.
NEXT_PUBLIC_SCREENSHOT_KEY=

# --- Private /sport workspace ----------------------------------------------
# Shared password for the gated /sport page. Unset, /sport returns 404 rather
# than opening up. Changing it signs every existing session out, because the
# password doubles as the session signing key. Use something long.
SPORT_PASSWORD=

# Origin of the upstream sports streaming API, no trailing slash, e.g.
# https://api.example.com — server-only on purpose: the /sport console calls
# our own /api/sport/* proxy so this host never reaches the browser. Unset,
# the console renders a "not configured" notice instead of failing.
SPORT_API_BASE_URL=
